{
  "cmake": {
    "GGML_CUDA": [
      "ON"
    ],
    "GGML_NATIVE": [
      "ON",
      "OFF"
    ],
    "GGML_LTO": [
      "ON",
      "OFF"
    ],
    "GGML_CPU_REPACK": [
      "ON",
      "OFF"
    ],
    "GGML_LLAMAFILE": [
      "ON",
      "OFF"
    ],
    "GGML_OPENMP": [
      "ON",
      "OFF"
    ],
    "GGML_SSE42": [
      "ON",
      "OFF"
    ],
    "GGML_AVX": [
      "ON",
      "OFF"
    ],
    "GGML_AVX2": [
      "ON",
      "OFF"
    ],
    "GGML_FMA": [
      "ON",
      "OFF"
    ],
    "GGML_F16C": [
      "ON",
      "OFF"
    ],
    "GGML_BMI2": [
      "ON",
      "OFF"
    ],
    "GGML_CUDA_FORCE_MMQ": [
      "ON",
      "OFF"
    ],
    "GGML_CUDA_FORCE_CUBLAS": [
      "ON",
      "OFF"
    ],
    "GGML_CUDA_NO_VMM": [
      "ON",
      "OFF"
    ],
    "GGML_CUDA_FA": [
      "ON",
      "OFF"
    ],
    "GGML_CUDA_FA_ALL_QUANTS": [
      "ON",
      "OFF"
    ],
    "GGML_CUDA_GRAPHS": [
      "ON",
      "OFF"
    ]
  },
  "compiler": {
    "-O": [
      "-O0",
      "-O1",
      "-O2",
      "-O3",
      "-Os",
      "-Ofast"
    ],
    "-ftree-vectorize": [
      "-ftree-vectorize",
      "-fno-tree-vectorize"
    ],
    "-ftree-loop-vectorize": [
      "-ftree-loop-vectorize",
      "-fno-tree-loop-vectorize"
    ],
    "-ftree-slp-vectorize": [
      "-ftree-slp-vectorize",
      "-fno-tree-slp-vectorize"
    ],
    "-fvect-cost-model": [
      "-fvect-cost-model=unlimited",
      "-fvect-cost-model=dynamic",
      "-fvect-cost-model=cheap",
      "-fvect-cost-model=very-cheap"
    ],
    "-funroll-loops": [
      "-funroll-loops",
      "-fno-unroll-loops"
    ],
    "-finline-functions": [
      "-finline-functions",
      "-fno-inline-functions"
    ],
    "-fstrict-aliasing": [
      "-fstrict-aliasing",
      "-fno-strict-aliasing"
    ],
    "-ffast-math": [
      "-ffast-math",
      "-fno-fast-math"
    ],
    "-funsafe-math-optimizations": [
      "-funsafe-math-optimizations",
      "-fno-unsafe-math-optimizations"
    ],
    "-ffp-contract": [
      "-ffp-contract=fast",
      "-ffp-contract=on",
      "-ffp-contract=off"
    ],
    "-fmath-errno": [
      "-fmath-errno",
      "-fno-math-errno"
    ],
    "-march": [
      "-march=x86-64",
      "-march=x86-64-v2",
      "-march=x86-64-v3",
      "-march=native"
    ],
    "-mprefer-vector-width": [
      "-mprefer-vector-width=128",
      "-mprefer-vector-width=256"
    ]
  },
  "invalid_combinations": [
    {
      "GGML_CUDA_FORCE_MMQ": "ON",
      "GGML_CUDA_FORCE_CUBLAS": "ON"
    }
  ]
}
