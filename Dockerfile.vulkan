FROM docker.io/library/ubuntu:24.04

ENV DEBIAN_FRONTEND=noninteractive \
    VIRTUAL_ENV=/opt/venv \
    PATH=/opt/venv/bin:$PATH \
    PYTHONUNBUFFERED=1

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    clang \
    cmake \
    git \
    glslc \
    libomp-dev \
    libvulkan-dev \
    mesa-vulkan-drivers \
    ninja-build \
    pkg-config \
    python3 \
    python3-pip \
    python3-venv \
    util-linux \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /workspace
COPY ml/requirements.txt ml/requirements.txt
RUN python3 -m venv "$VIRTUAL_ENV" \
    && pip install --no-cache-dir -r ml/requirements.txt

COPY ml/ ml/
COPY llama/flags.json llama/flags.json
COPY llama/filter_llama_performance_flags.py llama/filter_llama_performance_flags.py

RUN mkdir -p llama.cpp gguf models llama/results build

CMD ["bash"]
